<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root_scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:overScrollMode="never">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="8dp" android:paddingEnd="20dp" android:paddingBottom="88dp">
        <xyz.gramapple.wallet.CardStackView android:id="@+id/card_stack" android:layout_width="match_parent" android:layout_height="wrap_content">
            <xyz.gramapple.wallet.WalletCardView android:id="@+id/card_back" android:layout_width="match_parent" android:layout_height="wrap_content" android:clickable="false" android:focusable="false" />
            <xyz.gramapple.wallet.WalletCardView android:id="@+id/card" android:layout_width="match_parent" android:layout_height="wrap_content" android:contentDescription="@string/card_qr_description" />
        </xyz.gramapple.wallet.CardStackView>
        <TextView android:id="@+id/updated" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="#99FFFFFF" android:textSize="12sp" android:visibility="invisible" />
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:lineSpacingExtra="2dp" android:textColor="#FFFFFFFF" android:textSize="13sp" android:visibility="gone" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="@drawable/tx_row_bg" android:orientation="vertical" android:paddingStart="12dp" android:paddingTop="12dp" android:paddingEnd="12dp" android:paddingBottom="10dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:letterSpacing="0.08" android:text="@string/chart_title" android:textColor="#CCFFFFFF" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:id="@+id/chart_7" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center" android:paddingStart="8dp" android:paddingEnd="8dp" android:text="7D" android:textColor="#FFFFFFFF" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:id="@+id/chart_30" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center" android:paddingStart="8dp" android:paddingEnd="8dp" android:text="30D" android:textColor="#99FFFFFF" android:textSize="12sp" />
                <TextView android:id="@+id/chart_90" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center" android:paddingStart="8dp" android:paddingEnd="8dp" android:text="90D" android:textColor="#99FFFFFF" android:textSize="12sp" />
            </LinearLayout>
            <xyz.gramapple.wallet.BalanceChartView android:id="@+id/balance_chart" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:letterSpacing="0.12" android:text="@string/today_title" android:textColor="#99FFFFFF" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:id="@+id/today_all" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/today_all" android:textColor="#FF8FD0FF" android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/today_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical" />
        <TextView android:id="@+id/today_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/tx_row_bg" android:gravity="center" android:paddingStart="14dp" android:paddingTop="18dp" android:paddingEnd="14dp" android:paddingBottom="18dp" android:text="@string/today_empty" android:textColor="#99FFFFFF" android:textSize="13sp" android:visibility="gone" />
    </LinearLayout>
</ScrollView>

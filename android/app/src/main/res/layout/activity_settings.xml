<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/settings_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/app_bg" android:clipToPadding="false" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="20dp" android:paddingEnd="16dp" android:paddingBottom="28dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/settings_back" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:paddingEnd="8dp" android:text="@string/back" android:textColor="#FFFFFFFF" android:textSize="17sp" />
            <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="@string/settings_title" android:textColor="#FFFFFFFF" android:textSize="17sp" android:textStyle="bold" />
            <View android:layout_width="56dp" android:layout_height="1dp" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_marginTop="18dp" android:layout_marginBottom="6dp" android:letterSpacing="0.04" android:text="@string/wallets_section" android:textColor="#99FFFFFF" android:textSize="13sp" />
        <LinearLayout android:id="@+id/wallets_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/settings_group_bg" android:orientation="vertical" />
        <TextView android:id="@+id/wallet_add" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/settings_group_bg" android:gravity="center_vertical|start" android:minHeight="48dp" android:paddingStart="16dp" android:paddingTop="12dp" android:paddingEnd="16dp" android:paddingBottom="12dp" android:text="@string/wallet_add" android:textColor="#FFFFFFFF" android:textSize="17sp" />
        <LinearLayout android:id="@+id/add_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/settings_group_bg" android:orientation="vertical" android:padding="12dp" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal">
                <Button android:id="@+id/mode_own" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/button_mode_on" android:fontFamily="sans-serif-medium" android:minHeight="0dp" android:minWidth="0dp" android:stateListAnimator="@null" android:text="@string/mode_own" android:textAllCaps="false" android:textColor="@color/gram_blue" android:textSize="13sp" />
                <Button android:id="@+id/mode_other" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="8dp" android:layout_weight="1" android:background="@drawable/button_mode_off" android:fontFamily="sans-serif-medium" android:minHeight="0dp" android:minWidth="0dp" android:stateListAnimator="@null" android:text="@string/mode_other" android:textAllCaps="false" android:textColor="@color/white" android:textSize="13sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/own_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical" android:visibility="gone">
                <TextView android:id="@+id/own_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/own_connect_hint" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" />
                <TextView android:id="@+id/own_address" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:fontFamily="monospace" android:textColor="#CCFFFFFF" android:textSize="13sp" />
                <Button android:id="@+id/own_action" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="10dp" android:background="@drawable/button_white" android:fontFamily="sans-serif-medium" android:minHeight="0dp" android:minWidth="0dp" android:stateListAnimator="@null" android:text="@string/connect_wallet" android:textAllCaps="false" android:textColor="@color/gram_blue" android:textSize="14sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/other_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical">
                <EditText android:id="@+id/address_input" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/input_white" android:fontFamily="monospace" android:gravity="center_vertical" android:hint="@string/address_hint" android:imeOptions="actionDone" android:importantForAutofill="no" android:inputType="textNoSuggestions|textVisiblePassword" android:maxLines="1" android:paddingStart="14dp" android:paddingEnd="14dp" android:singleLine="true" android:textColor="#FF0088FF" android:textColorHint="#800C83FF" android:textCursorDrawable="@null" android:textSize="13sp" />
                <Button android:id="@+id/save_address" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" android:background="@drawable/button_white" android:fontFamily="sans-serif-medium" android:minHeight="0dp" android:minWidth="0dp" android:stateListAnimator="@null" android:text="@string/save_address" android:textAllCaps="false" android:textColor="@color/gram_blue" android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_marginTop="22dp" android:layout_marginBottom="6dp" android:letterSpacing="0.04" android:text="@string/notifications_label" android:textColor="#99FFFFFF" android:textSize="13sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/settings_group_bg" android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="4dp" android:paddingEnd="12dp" android:paddingBottom="10dp">
            <Switch android:id="@+id/notify_switch" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/notifications_title" android:textColor="#FFFFFFFF" android:textSize="16sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/notifications_hint" android:textColor="#99FFFFFF" android:textSize="13sp" />
            <LinearLayout android:id="@+id/notify_types" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" android:visibility="gone">
                <Switch android:id="@+id/notify_payments" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="44dp" android:text="@string/notify_payments_title" android:textColor="#FFFFFFFF" android:textSize="15sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/notify_payments_hint" android:textColor="#99FFFFFF" android:textSize="12sp" />
                <Switch android:id="@+id/notify_gifts" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:minHeight="44dp" android:text="@string/notify_gifts_title" android:textColor="#FFFFFFFF" android:textSize="15sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/notify_gifts_hint" android:textColor="#99FFFFFF" android:textSize="12sp" />
                <Switch android:id="@+id/notify_updates" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:minHeight="44dp" android:text="@string/notify_updates_title" android:textColor="#FFFFFFFF" android:textSize="15sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/notify_updates_hint" android:textColor="#99FFFFFF" android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="22dp" android:orientation="horizontal">
            <LinearLayout android:id="@+id/refresh_now" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="5dp" android:layout_weight="1" android:background="@drawable/settings_group_bg" android:gravity="center" android:orientation="horizontal">
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:contentDescription="@string/refresh_now" android:src="@drawable/ic_refresh_bal" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/refresh_now" android:textColor="#FFFFFFFF" android:textSize="15sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/open_stats" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="5dp" android:layout_weight="1" android:background="@drawable/settings_group_bg" android:gravity="center" android:orientation="horizontal">
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:contentDescription="@string/open_stats" android:src="@drawable/ic_app_ana" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/open_stats" android:textColor="#FFFFFFFF" android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_marginTop="22dp" android:layout_marginBottom="6dp" android:letterSpacing="0.04" android:text="@string/about_section" android:textColor="#99FFFFFF" android:textSize="13sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/settings_group_bg" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingTop="12dp" android:paddingEnd="8dp" android:paddingBottom="12dp">
            <LinearLayout android:id="@+id/about_creator" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="?android:attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal" android:paddingTop="2dp" android:paddingBottom="2dp">
                <ImageView android:id="@+id/about_creator_avatar" android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/avatar_circle_bg" android:contentDescription="@string/author_coonlink" android:scaleType="centerCrop" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/author_coonlink" android:textColor="#FFFFFFFF" android:textSize="16sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/about_creator_role" android:textColor="#99FFFFFF" android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
            <ImageButton android:id="@+id/about_more" android:layout_width="40dp" android:layout_height="40dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="@string/credits_title" android:padding="8dp" android:scaleType="fitCenter" android:src="@drawable/ic_more_vert" />
        </LinearLayout>
        <TextView android:id="@+id/about_version" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center" android:textColor="#99FFFFFF" android:textSize="12sp" />
        <TextView android:id="@+id/about_copyright" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:textColor="#66FFFFFF" android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
